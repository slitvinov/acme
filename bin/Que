#!/bin/sh
queue() {
	case $1 in
	/*) f=$1 ;;
	*) f=$(pwd)/$1 ;;
	esac
	mpcmd loadfile "\"$f\"" append-play >/dev/null
}
if [ $# -gt 0 ]
then
	for f
	do
		queue "$f"
	done
	exit 0
fi
[ -t 0 ] && exit 0
/usr/bin/sed 's/^[> ] *[0-9]* //' | while IFS= read -r f
do
	[ -n "$f" ] || continue
	queue "$f"
done
