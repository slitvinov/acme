#!/bin/sh
URL=https://recreation.gocrimson.com/sports/2021/5/14/facility-hours.aspx
die() {
    rc=$1; shift
    printf 'Pool: error: %s\n' "$*" >&2
    if test -n "${err:-}"; then cat "$err" >&2; fi
    exit "$rc"
}

for c in "${LYNX:=lynx}"
do command -v "$c" >/dev/null
   case $? in
       0) ;;
       *) die $? "command '$c' not found" ;;
   esac
done

err=${TMPDIR:-/tmp}/err.$$
trap 'rm -f "$err"' 0
trap 'exit 1' 1 2 15

t=`/bin/date +%m/%d | /usr/bin/sed 's|^0||; s|/0|/|'`

mkdir -p "$HOME/.cache/Pool"
out=$HOME/.cache/Pool/`/bin/date +%Y%m%d`

if test ! -s "$out"
then
    rm -f "$HOME/.cache/Pool"/*
    "$LYNX" -dump "$URL" > "$out" 2>"$err"
    case $? in
        0) ;;
        *) rm -f "$out"; die $? "download of facility hours failed" ;;
    esac
fi

/usr/bin/awk -v t="$t" '
/MAC Pool +Blodgett Pool/ { print; f = 1; next }
f && $1 == t { print; ok = 1; exit }
END { exit !ok }' "$out"
case $? in
    0) ;;
    *) die $? "no hours found for $t" ;;
esac
